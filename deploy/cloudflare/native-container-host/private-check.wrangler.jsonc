{
  "name": "vision-community-native-check-staging",
  "main": "../tools/private-native-host-check.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "services": [{ "binding": "NATIVE_OPERATOR", "service": "vision-community-native-host-staging", "entrypoint": "NativeSceneOperator" }],
  "r2_buckets": [{ "binding": "CHECK_REPORTS", "bucket_name": "vision-community-staging" }],
  "vars": {
    "CHECK_MODE": "launch",
    "CHECK_NOT_BEFORE": "2000-01-01T00:00:00.000Z",
    "CHECK_NOT_AFTER": "2000-01-01T00:01:00.000Z",
    "CHECK_RECEIPT_KEY": "native-host/checks/local-operator-check.json",
    "OPERATOR_BUCKET_NAME": "vision-community-staging"
  }
}
