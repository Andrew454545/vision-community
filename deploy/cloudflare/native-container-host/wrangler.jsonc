{
  "name": "vision-community-native-host-staging",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "NATIVE_HOST", "class_name": "NativeHostProbe" }] },
  "exports": {
    "NativeHostProbe": { "type": "durable-object", "storage": "sqlite", "container": "vision-community-native-host-staging" },
    "NativeSceneSearch": { "type": "worker", "cache": { "enabled": false } },
    "NativeSceneVerification": { "type": "worker", "cache": { "enabled": false } },
    "NativeSceneOperator": { "type": "worker", "cache": { "enabled": false } },
    "default": { "type": "worker", "cache": { "enabled": false } }
  },
  "limits": { "cpu_ms": 5000 },
  "r2_buckets": [{ "binding": "OPERATOR_BUNDLES", "bucket_name": "vision-community-staging" }],
  "vars": {
    "OPERATOR_BUCKET_NAME": "vision-community-staging",
    "NATIVE_IMAGERY_EGRESS": "disabled",
    "NATIVE_RUNTIME_SHA256": "bbc60e94e6590c657f256d89f6d63db47f7f3d53d1ba37ffeafba07b6211d64e",
    "NATIVE_IMAGE": "registry.cloudflare.com/272760294910ef0b246980278aeb36e2/vision-community-native-scene@sha256:d951eff7987b0284d333f193489de339cc5bd63252284bfc8297d1a322bf91d6"
  },
  "containers": [{
    "name": "vision-community-native-host-staging",
    "class_name": "NativeHostProbe",
    "scheduling_policy": "durable_object",
    "images": { "native": { "image": "registry.cloudflare.com/272760294910ef0b246980278aeb36e2/vision-community-native-scene@sha256:d951eff7987b0284d333f193489de339cc5bd63252284bfc8297d1a322bf91d6" } }
  }]
}
